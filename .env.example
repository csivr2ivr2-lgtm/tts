TTS_API_KEY=replace-with-a-long-random-secret
TTS_LANGUAGE=hebrew
TTS_VOICE_NAME=ari
TTS_VOICE_FILE=voices/ari.wav
TTS_REQUIRE_CUSTOM_VOICE=true
TTS_MAX_TEXT_LENGTH=1200
TTS_CACHE_MAX_ITEMS=100

# Prepared voice profile is kept outside Hostinger domain/build folders so it survives restarts/redeploys.
# TTS_PERSIST_DIR=/home/USER/.cache/aharon-tts
# Optional override:
# TTS_VOICE_PROFILE_FILE=/home/USER/.cache/aharon-tts/ari.voice

# Keep the one-time encoder download cached so rebuilding a better voice later is fast.
TTS_KEEP_ENCODER=true

# Optional: self-hosted Hebrew model folder or URL.
# TTS_MODELS_URL=/absolute/path/to/models/he/

# Local speech-to-text (Whisper via Transformers.js)
STT_MODEL=Xenova/whisper-base
STT_DTYPE=q8
STT_LANGUAGE=hebrew
# Whisper is lazy-loaded and unloaded from RAM after this idle period; disk cache stays.
STT_IDLE_UNLOAD_MS=60000
STT_MAX_AUDIO_BYTES=8388608
STT_MAX_AUDIO_SECONDS=120
# Optional persistent cache override:
# STT_CACHE_DIR=/home/USER/.cache/aharon-tts/whisper

# Telephony codecs used for SIP/RTP media. Implemented in-process; no ffmpeg required.
TELEPHONY_CODEC=pcmu
TELEPHONY_SAMPLE_RATE=8000

# Yemot Internet Softphone SIP/WSS settings.
# Keep credentials only in Hostinger environment variables.
SIP_WS_URL=wss://sip.yemot.co.il/ws
SIP_DOMAIN=sip.yemot.co.il
SIP_USER=
# Prefer HA1 when available. Treat it as a secret credential.
SIP_HA1=
SIP_REALM=sip.yemot.co.il.wss
# Password is only a fallback when SIP_HA1 is empty.
SIP_PASSWORD=
# Optional full SIP URI. When empty, sip:SIP_USER@SIP_DOMAIN is used.
# SIP_URI=sip:YOUR_ACCOUNT_ID@sip.yemot.co.il
SIP_DISPLAY_NAME=Aharon Voice AI
SIP_REGISTER_EXPIRES=300
SIP_AUTO_CONNECT=true
# Keep enabled after validating the correct WSS endpoint and credentials so registration survives transient disconnects.
SIP_CONNECTION_RECOVERY=true
# Until the WebRTC media bridge is enabled, reject inbound INVITEs cleanly.
SIP_REJECT_UNBRIDGED=true
# Optional WebSocket Origin if the provider requires one.
# SIP_WS_ORIGIN=https://tts.aharon.cloud
# Optional network diagnostics/tuning.
SIP_WS_HANDSHAKE_TIMEOUT_MS=10000
SIP_CONNECT_TIMEOUT_MS=15000
# 0/empty = auto, 4 = IPv4 only, 6 = IPv6 only.
# SIP_IP_FAMILY=4
